# DART Open API (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=your_dart_api_key_here

# PostgreSQL (docker-compose.yml 기본값과 일치)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dart_rag
POSTGRES_USER=dart_rag
POSTGRES_PASSWORD=dart_rag_dev_password

# HuggingFace 모델
EMBEDDING_MODEL=BAAI/bge-m3
GENERATION_MODEL=Qwen/Qwen2.5-7B-Instruct
# 모델 캐시 경로 (선택)
HF_HOME=./model_cache

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
